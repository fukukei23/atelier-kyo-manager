# メモ:
# 日付: 2025年9月23日 (日本時間)
# フォルダ名: atelier-kyo-manager/
# ファイル名: .gitignore (完成版)
# 使い方: この内容で既存の .gitignore ファイルを完全に上書きしてください。
# 役割: Gitのバージョン管理から、秘密情報、環境依存ファイル、自動生成される成果物を一括で除外します。

# --- Secrets (秘密情報) ---
# APIキーやパスワードなど。リポジトリに含めてはいけない最重要ファイル。
.env

# .envのテンプレートファイルは、必要な環境変数を周知するためにリポジトリに含めます。
# `!` は「無視しない」という例外ルールです。
!.env.template


# --- Python Virtual Environments (仮想環境) ---
# OSや環境ごとに異なり、サイズも大きいためリポジトリに含めません。
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/


# --- Python Cache & Compiled Files (キャッシュ) ---
# Pythonが実行時に自動生成するファイル。不要であり、コンフリクトの原因になります。
__pycache__/
*.pyc
*.pyo
*.pyd


# --- IDE / Editor Settings (開発環境の設定) ---
# 個人のエディタ設定が他の開発者に影響を与えないようにします。
.vscode/
.idea/


# --- Generated Outputs & Logs (生成物とログ) ---
# アプリケーションが実行時に生成するすべてのファイル/フォルダ。
# レポート(HTML/CSV/PNG)、履歴(JSON)、デバッグ情報などを一括で除外します。
output/
logs/
*.log
error_screenshots/

# 開発用のデバッグ成果物（スクリーンショットやHTMLレスポンスなど）。
instance/supplier_debug/


# --- Distribution / Packaging (パッケージング) ---
# ライブラリとして配布する際に生成されるフォルダ（将来的な拡張のため）。
build/
dist/
*.egg-info/


# --- Framework Specific (フレームワーク固有) ---
# 開発用のローカルデータベースなど。
instance/site.db
db.sqlite3


# --- OS Generated Files (OSが自動生成するファイル) ---
# macOSやWindowsが自動で生成する隠しファイル。
.DS_Store
Thumbs.db

/instance/pw_profiles/
/instance/runs/

# Playwright / browser cache profiles
/instance/pw_profile/
/instance/pw_profile_supplier/

# Temporary video frames
/tmp/video_frames/

# Exported archives / generated packs
/exports/
/exports_atelier/

# Misc generated backups
app/models_backup.py

# Chat records (auto-saved, excluded from GitHub)
docs/chat_records/
docs/chat_records/*.md
