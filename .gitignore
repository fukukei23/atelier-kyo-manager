# メモ:
# 日付: 2025年9月23日 (日本時間)
# フォルダ名: atelier-kyo-manager/
# ファイル名: .gitignore (完成版)
# 使い方: この内容で既存の .gitignore ファイルを完全に上書きしてください。
# 役割: Gitのバージョン管理から、秘密情報、環境依存ファイル、自動生成される成果物を一括で除外します。

# --- Secrets (秘密情報) ---
# APIキーやパスワードなど。リポジトリに含めてはいけない最重要ファイル。
.env

# .envのテンプレートファイルは、必要な環境変数を周知するためにリポジトリに含めます。
# `!` は「無視しない」という例外ルールです。
!.env.template


# --- Python Virtual Environments (仮想環境) ---
# OSや環境ごとに異なり、サイズも大きいためリポジトリに含めません。
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/


# --- Python Cache & Compiled Files (キャッシュ) ---
# Pythonが実行時に自動生成するファイル。不要であり、コンフリクトの原因になります。
__pycache__/
*.pyc
*.pyo
*.pyd


# --- IDE / Editor Settings (開発環境の設定) ---
# 個人のエディタ設定が他の開発者に影響を与えないようにします。
.vscode/
.idea/


# --- Generated Outputs & Logs (生成物とログ) ---
# アプリケーションが実行時に生成するすべてのファイル/フォルダ。
# レポート(HTML/CSV/PNG)、履歴(JSON)、デバッグ情報などを一括で除外します。
output/
logs/
*.log
error_screenshots/

# 開発用のデバッグ成果物（スクリーンショットやHTMLレスポンスなど）。
instance/supplier_debug/


# --- Distribution / Packaging (パッケージング) ---
# ライブラリとして配布する際に生成されるフォルダ（将来的な拡張のため）。
build/
dist/
*.egg-info/


# --- Framework Specific (フレームワーク固有) ---
# 開発用のローカルデータベースなど。
instance/
data/app.db


# --- OS Generated Files (OSが自動生成するファイル) ---
# macOSやWindowsが自動で生成する隠しファイル。
.DS_Store
Thumbs.db

/instance/pw_profiles/
/instance/runs/

# Playwright / browser cache profiles
/instance/pw_profile/
/instance/pw_profile_supplier/

# Temporary video frames
/tmp/video_frames/

# Exported archives / generated packs
/exports/
/exports_atelier/

# Misc generated backups
app/models_backup.py

# Chat records (auto-saved, excluded from GitHub)
docs/chat_records/
docs/chat_records/*.md

# --- Organized Directories (整理されたディレクトリ) ---
# 開発スクリプト（scripts/dev/ は Git に含めるが、生成物は除外）
scripts/dev/*.log
scripts/dev/*.tmp
tools/test_*.py
scripts/dev/test_*.py

# レポート（docs/reports/ は Git に含めるが、一時レポートは除外）
docs/reports/*.tmp

# 生成されたログ・一時ファイル・データ（すべて除外）
logs/generated/
tmp/generated/
data/generated/

# --- Test & Development Scripts (テスト・開発用スクリプト) ---
# ルートディレクトリに散在する一時的なテストスクリプト
check_*.py
execute_*.py
run_*_test*.py
verify_*.py
quick_*.py
show_*.py
move_*.py
organize_*.py
measure_*.py
fix_*.py
remove_*.py
auto_*.py
debug_*.py
multi_*.py
pricing_*.py
buyma_*.py

# --- Generated Data Files (生成されたデータファイル) ---
# CSV、HTML、JSONなどの生成物
*.csv
!requirements.txt
page_source.html
sample.html
output.csv
catalog_*.csv

# Allow CSV fixtures for tests (override global *.csv ignore)
!tests/fixtures/**/*.csv


# --- Coverage & Test Reports (カバレッジ・テストレポート) ---
coverage.json
.coverage
htmlcov/
.pytest_cache/
test_output.log
test_*.log
browser_test_*.log

# --- Backup & Archive Files (バックアップ・アーカイブ) ---
*.zip
!*.zip.example
_backup/
codex_history/

# --- Generated Graph & Analysis Files (生成されたグラフ・分析ファイル) ---
depgraph.json
project_dependency_graph.json
tree.txt
git_status_check_result.txt

# --- Local Configuration Overrides (ローカル設定のオーバーライド) ---
overrides.local.json
*.local.json
!*.local.json.example
!fkb_local.json

# --- Temporary Directories (一時ディレクトリ) ---
tmp/
catalog_images/
screenshots/
images/
debug_catalog/
project-root/

# Secrets file
app/config/secrets.py

# Test result log files (temporary)
docs/reports/TEST_RESULTS_*.txt

# Generated outputs (do not commit)
data/exports/
data/exports/*.json
data/exports/*.jsonl

# Local input files (do not commit)
data/imports/

# Claude Code overrides backups
.overrides_backups/

# ONNX model files (generated by ai_model_builder.py)
*.onnx

# Old project root configs
project-root/
