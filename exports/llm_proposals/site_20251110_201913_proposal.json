{
  "code_hints": [
    "After navigation, wait for either plp_ready selectors or a country/cookie modal; click consent and country continue if present, then re-check plp_ready.",
    "Perform incremental scrolling (6–8 steps with ~600ms delay) to trigger lazy-loaded tiles before concluding 'no product tiles'.",
    "If no tiles but plp_ready container exists, wait an extra 2–3 seconds for XHR content and retry query for product_card selectors.",
    "Set Accept-Language to en-GB to reduce locale gating; keep host pinned to www.moncler.com and reject redirects to monclergroup.com.",
    "If URL contains '/en-gb/en-int/', rewrite to '/en-gb/' before loading."
  ],
  "overrides_patch": {
    "headers": {
      "Accept-Language": "en-GB,en;q=0.9"
    },
    "wait_for_selectors": {
      "plp_ready": [
        "[data-component='product-grid']",
        "[data-testid='plp-grid']",
        ".product-grid"
      ]
    },
    "on_load_actions": [
      {
        "click_if_present": [
          "#onetrust-accept-btn-handler",
          "button[aria-label='Accept all cookies']",
          "button:has-text('Accept All')"
        ]
      },
      {
        "click_if_present": [
          "[data-testid='country-continue']",
          "button:has-text('Continue to')",
          "button:has-text('Continue')"
        ]
      }
    ],
    "scroll": {
      "enabled": true,
      "steps": 8,
      "delay_ms": 600
    }
  },
  "url_rules": {
    "normalize": [
      {
        "when_host_matches": "www.moncler.com",
        "pattern": "^/(en-[a-z]{2})/en-int/(.*)$",
        "replace_with": "/$1/$2"
      },
      {
        "when_host_matches": "www.moncler.com",
        "pattern": "/en-int/",
        "replace_with": "/"
      }
    ],
    "force_locale_prefix": [
      {
        "when_host_matches": "www.moncler.com",
        "if_path_missing_locale": true,
        "prepend": "/en-gb"
      }
    ],
    "block": [
      "https://www.monclergroup.com/*"
    ],
    "stay_on_host": [
      "www.moncler.com"
    ]
  },
  "selectors_patch": {
    "plp": {
      "product_card": [
        "[data-testid='plp-product-tile']",
        "a[data-testid='product-tile']",
        ".product-grid a[href*='/products/']",
        "li[data-product-id] a[href*='/products/']"
      ],
      "product_link": [
        "a[href*='/products/']"
      ],
      "price": [
        "[data-testid='price']",
        ".price",
        ".product-price"
      ]
    },
    "consent": {
      "accept_all": [
        "#onetrust-accept-btn-handler",
        "button[aria-label='Accept all cookies']",
        "button:has-text('Accept All')"
      ]
    },
    "modals": {
      "country_continue": [
        "[data-testid='country-continue']",
        "button:has-text('Continue to')",
        "button:has-text('Continue')"
      ]
    }
  },
  "risk": "medium",
  "rationale": "PLPが空だった原因は、Moncler特有のロケールゲート（en-int）混在やクッキーバナー/国選択モーダルで商品グリッドが描画されない可能性が高いです。URLに「/en-gb/en-int/」が入っており、これを除去して単一ロケールへ正規化することで安定します。加えて、クッキー同意と国選択のクリックを先行処理し、グリッド/タイルの実際のDOMに合わせたフォールバック型セレクタを追加、さらに遅延ロード対策としてスクロールを明示化します。これらは設定ファイルの最小差分で解決可能です。"
}