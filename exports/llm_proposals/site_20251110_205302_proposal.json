{
  "overrides_patch": {
    "start_url": "https://www.moncler.com/en-gb/men/ready-to-wear/jackets",
    "wait_for_selectors": [
      "#onetrust-accept-btn-handler",
      "[data-testid='product-grid']",
      "a[data-testid='product-card-link']"
    ],
    "plp_fallback_urls": [
      "https://www.moncler.com/en-gb/women/ready-to-wear/jackets"
    ],
    "navigation_fallback": [
      {
        "click": "#onetrust-accept-btn-handler",
        "optional": true,
        "wait": 200
      },
      {
        "click": "a[href='/en-gb/men/']",
        "optional": true,
        "post_wait_for": "a[href*='/en-gb/men/ready-to-wear/jackets']"
      },
      {
        "click": "a[href*='/en-gb/men/ready-to-wear/jackets']",
        "optional": true
      }
    ],
    "scroll": {
      "strategy": "incremental",
      "step_px": 800,
      "max_passes": 8,
      "stop_when_selector_count_gte": {
        "selector": "a[data-testid='product-card-link']",
        "count": 12
      }
    },
    "block_hosts": [
      "www.monclergroup.com"
    ],
    "allow_url_patterns": [
      "^https://www\\.moncler\\.com/en-gb/(men|women)/.+"
    ],
    "ignore_query_params": [
      "utm_*",
      "gclid",
      "mbid",
      "icid",
      "cm_mmc"
    ],
    "timeouts": {
      "dom_content_loaded_ms": 15000,
      "plp_wait_ms": 20000
    }
  },
  "url_rules": {},
  "code_hints": [
    "On page load, attempt to click #onetrust-accept-btn-handler if present before any other interaction.",
    "If current URL is the homepage or does not match allow_url_patterns, apply the url_rules redirect to the default PLP.",
    "Wait for [data-testid='product-grid'] and at least one of the tile selectors; then perform incremental scrolling to load more tiles.",
    "Extract PDP links from the tile itself when tile_link ':scope' matches an <a>, otherwise query a[href] within the tile.",
    "If no tiles after timeout, navigate to plp_fallback_urls[0] and retry the same wait and scroll logic.",
    "On PDP, wait for either pdp.title or pdp.price to appear; handle currency symbol normalization from the text content."
  ],
  "risk": "medium",
  "selectors_patch": {
    "plp": {
      "container": [
        "[data-testid='product-grid']",
        "section[class*='product'][class*='grid']",
        "ul[class*='product'][class*='grid']"
      ],
      "tile": [
        "a[data-testid='product-card-link']",
        "a[data-test='product-card-link']",
        "article [data-testid*='product'][href]",
        "li [href][aria-label*='View Product']",
        "a[href*='/en-gb/'][href*='/products/']"
      ],
      "tile_link": [
        ":scope",
        "a[href]"
      ],
      "tile_title": [
        "[data-testid='product-name']",
        "[data-test='product-name']",
        "[class*='product'] [class*='name']",
        "a[title]"
      ],
      "tile_price": [
        "[data-testid='product-price']",
        "[data-test='product-price']",
        "[class*='price']"
      ]
    },
    "pdp": {
      "title": [
        "h1[data-testid='pdp-title']",
        "h1[class*='product']",
        "h1"
      ],
      "price": [
        "[data-testid='pdp-price']",
        "[data-test='pdp-price']",
        "div[class*='price'] span"
      ]
    },
    "modals": {
      "cookie_accept": [
        "#onetrust-accept-btn-handler",
        "button#onetrust-accept-btn-handler",
        "button[id*='onetrust'][aria-label*='Accept']",
        "button[title*='Accept All Cookies']"
      ]
    }
  },
  "rationale": "The run landed on the homepage (/en-gb/) which has no product tiles. We add a deterministic default PLP (men jackets) with a women jackets fallback, handle the OneTrust cookie banner, and constrain navigation to en-gb product paths. The PLP/PDP selectors include stable data-testid patterns with generic fallbacks. URL normalization avoids locale traps (e.g., /en-jp) and blocks monclergroup.com."
}