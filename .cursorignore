# ================================
# Python 仮想環境 / キャッシュ類
# ================================
.venv/
venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/

# ================================
# Git / VSCode / Node
# ================================
.git/
.gitignore
.vscode/
node_modules/

# ================================
# Flask / Webアプリ特有の出力物
# ================================
dist/
build/
*.log
logs/
**/logs/
tmp/
temp/
cache/
sessions/
uploads/

# ================================
# UI 層（Flask）は Cursor 編集禁止
# ================================
app/templates/
app/forms/
app/static/

# ================================
# Flask ルーティング層（編集禁止）
# ================================
# 注: app/routes.py は .cursorrules で個別制御

# ================================
# 実行時ファイル / 結果物
# ================================
instance/
# ただし、初期化ファイル（last_run.json など）は許可
# 注意: パターンの順序が重要。instance/ の後に ! で例外を指定
!instance/**/last_run.json
!instance/**/last_run.json.example
export/
exports/
debug_catalog/
screenshots/
**/screenshots/
**/network.har
**/trace.zip

# ================================
# セキュリティ / 機密情報
# ================================
.env
app/config/secrets.py

# ================================
# インフラ / Docker / n8n
# ================================
docker/
n8n/
compose/
infrastructure/

# ================================
# BUYMA 自動化ツール特有の重い領域
# ================================
# 画像バッチ処理で生成されるファイル
processed_images/
image_cache/
image_output/
thumbnails/
optimized_images/

# Selenium / WebDriver
webdriver/
chromedriver/
geckodriver/

# ================================
# 画像・データ・ダンプ類
# ================================
data/
datasets/
downloads/
raw_images/
raw_data/
csv/
backup/

# ================================
# AI モジュール系フォルダ（重い）
# ================================
models/
vector_store/
chroma_db/
embeddings/
tokenizers/

# ================================
# テスト生成物
# ================================
coverage/
htmlcov/
.coverage*

# ================================
# Docs / build artifacts
# ================================
docs/_build/
docs/.vitepress/
site/
*.zip
*.tar
*.tar.gz

# ================================
# プロジェクト特有（BUYMA 自動化）
# ================================
