{
    "SSENSE": {
        "home_url": "https://www.ssense.com/ja-jp",
        "discovery_settings": {
            "use_warm_up": true,
            "use_http2_fallback": false,
            "max_navigation_attempts": 2,
            "navigation_tactics": [
                "direct_brand_url"
            ],
            "url_templates": {
                "direct_brand_url": "/ja-jp/men/designers/{brand}"
            },
            "timeout_sec": 15
        },
        "selectors": {
            "pdp": {
                "plp_navigation_selectors": [],
                "pdp_link_selectors": [
                    "a:has(img[alt*='{brand}'])",
                    "article a:has(img)",
                    "a[href*='/men/'][href*='/product']",
                    "a[href*='/women/'][href*='/product']"
                ]
            }
        }
    },
    "MATCHESFASHION": {
        "home_url": "https://www.matchesfashion.com/jp/",
        "discovery_settings": {
            "use_warm_up": false,
            "use_http2_fallback": true,
            "max_navigation_attempts": 3,
            "navigation_tactics": [
                "designers_hub",
                "direct_brand_url"
            ],
            "url_templates": {
                "designers_hub": "/jp/designers",
                "direct_brand_url": "/jp/designers/{brand}"
            },
            "timeout_sec": 45
        },
        "selectors": {
            "pdp": {
                "plp_navigation_selectors": [],
                "pdp_link_selectors": [
                    "a[data-testid='product-card-link']:has(img[alt])",
                    ".lister__product a[href*='/products/']"
                ]
            }
        }
    },
    "FLANNELS": {
        "home_url": "https://www.flannels.com/",
        "discovery_settings": {
            "use_warm_up": true,
            "use_http2_fallback": false,
            "max_navigation_attempts": 2,
            "navigation_tactics": [
                "direct_brand_url"
            ],
            "url_templates": {
                "direct_brand_url": "/{brand}"
            },
            "timeout_sec": 20
        },
        "selectors": {
            "pdp": {
                "pdp_link_selectors": [
                    "a.ProductCard:has(span:has-text('{brand}'))",
                    "a.ProductCard"
                ]
            }
        }
    },
    "GIVENCHY_OFFICIAL": {
        "home_url": "https://www.givenchy.com/",
        "discovery_settings": {
            "navigation_tactics": [
                "official_catalog"
            ],
            "url_templates": {
                "official_catalog": "/en-en/men/new-in"
            },
            "fallback_url": "/en-en/men/new-in",
            "timeout_sec": 20,
            "max_navigation_attempts": 2,
            "use_warm_up": false,
            "use_http2_fallback": false
        },
        "selectors": {
            "pdp": {
                "plp_navigation_selectors": [
                    "a:has-text('Shop now')",
                    "a:has-text('MEN')"
                ],
                "view_more_selectors": [
                    "a:has-text('VIEW MORE')",
                    "button:has-text('VIEW MORE')"
                ],
                "plp_container_selectors": [
                    ".product-grid",
                    ".plp",
                    "[data-component='product-listing']",
                    "main .grid",
                    "section[class*='product-list']"
                ],
                "pdp_link_selectors": [
                    ".product-grid [data-product-url]",
                    ".product-grid a[href*='/en-en/'][href*='/p/']",
                    ".product-grid article:has(img)",
                    ".product-grid a:has(img)"
                ],
                "wait_for_selectors": [
                    "main",
                    "h1",
                    "[itemprop='price']",
                    "meta[property='product:price:amount']"
                ],
                "title": [
                    "meta[property='og:title']",
                    "[itemprop='name']",
                    "h1"
                ],
                "price": [
                    "meta[property='product:price:amount']",
                    "[itemprop='price']",
                    "meta[itemprop='price']",
                    "[data-test*='price']",
                    "[class*='price']",
                    "[data-component='PriceFinalLarge']"
                ],
                "brand": [
                    "meta[property='og:site_name']",
                    "meta[name='application-name']"
                ]
            }
        }
    }
}
