{
    "sites": [
        {
            "name": "BUYMA",
            "home_url": "https://www.buyma.com/",
            "domains": ["buyma.com"],
            "search_template": "https://www.buyma.com/r/-/search/?q={q}",
            "wait_until": "domcontentloaded",
            "timeout_sec": 30,
            "selectors": {
                "results_item": "a[href*='/item/']",
                "first_product_link": "a[href*='/item/']",
                "pdp": {
                    "title": ["h1[itemprop='name']", "h1.product_title", "h1"],
                    "price": ["span.Price_Txt","#price",".product_price .Price_Txt","span[itemprop='price']"]
                }
            }
        }
    ],
    "default_discovery_settings": {
        "use_low_footprint_mode": true,
        "use_persistent_context": true,
        "navigation_tactics": [
            "direct_brand_url"
        ],
        "fingerprint": {
            "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
            "viewport": {"width": 1920, "height": 1080},
            "locale": "ja-JP",
            "timezone": "Asia/Tokyo"
        },
        "manual_captcha": false,
        "max_attempts_per_site": 1,
        "max_url_candidates": 3,
        "timeout_sec": 20,
        "captcha_selectors": [
            "text=Press and Hold",
            "text=長押し",
            "iframe[src*='arkose']",
            "iframe[src*='cloudflare']"
        ]
    }
}

