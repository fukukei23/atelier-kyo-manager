    {
      "id": "moncler_plp_001",
      "site": "MONCLER_OFFICIAL",
      "error_signature": "PLP did not materialize (no product tiles)",
      "conditions": {
        "final_url_contains": ["client-service", "contact", "en-jp"],
        "tile_count": 0
      },
      "root_cause": "ロケール・ゲート問題: サイトが /en-jp/ または /client-service/contact/ へリダイレクトしている",
      "solution_pattern": [
        "force_locale_to_en_int",
        "dismiss_one_trust",
        "retry_with_hard_plp_url"
      ],
      "recovery_url": "https://www.moncler.com/en-int/women/outerwear/all-down-jackets/?forceLocale=en-int&shipToCountry=GB",
      "verified_date": "2025-11-15"
    },
    {
      "id": "moncler_plp_002",
      "site": "MONCLER_OFFICIAL",
      "error_signature": "Selector timeout - no elements found",
      "conditions": {
        "selectors_tested": ["article[data-testid='product-card']"],
        "tile_count": 0
      },
      "root_cause": "PLP セレクタ不一致: サイトが DOM 構造を変更した可能性",
      "solution_pattern": [
        "try_alternate_selectors",
        "use_fallback_tile_patterns"
      ],
      "alternate_selectors": [
        "div[data-testid='product-tile']",
        "div[class*='product-card']",
        "a[data-test='product-card-link']"
      ],
      "verified_date": "2025-11-15"
    },
    {
      "id": "moncler_plp_003",
      "site": "MONCLER_OFFICIAL",
      "error_signature": "Cookie consent overlay blocking content",
      "conditions": {
        "dom_contains": ["onetrust", "cookie"],
        "tile_count": 0
      },
      "root_cause": "OneTrust GDPR バナーがコンテンツを読み込めない",
      "solution_pattern": [
        "click_onetrust_accept",
        "wait_for_content"
      ],
      "selectors": {
