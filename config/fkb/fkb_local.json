    {
      "id": "generic_timeout_001",
      "site": "GENERIC",
      "error_signature": "TimeoutError - navigation or action timed out",
      "conditions": {
        "error_type": "TimeoutError",
        "timeout_ms": 30000
      },
      "root_cause": "ネットワーク遅延またはサーバー応答不良",
      "solution_pattern": [
        "retry_with_extended_timeout",
        "check_network_connection",
        "fallback_to_cache"
      ],
      "auto_apply_rules": {
        "max_retries": 2,
        "retry_delay_ms": 2000,
        "increase_timeout_by": 1.5
      },
      "verified_date": "2026-03-21"
    },
