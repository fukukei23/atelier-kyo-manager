        "accept_alt": "button:has-text('Accept All')"
      },
      "verified_date": "2025-11-15"
    },
    {
      "id": "moncler_plp_004",
      "site": "MONCLER_OFFICIAL",
      "error_signature": "Locale redirect loop",
      "conditions": {
        "url_pattern": "/en-[a-z]{2}/en-[a-z]{2}/"
      },
      "root_cause": "二重ロケールURL（例: /en-de/en-int/）が発生している",
      "solution_pattern": [
        "normalize_double_locale",
        "strip_extra_locale_prefix"
      ],
      "regex_pattern": "s#/en-[a-z]{2}/en-[a-z]{2}/#/en-int/#g",
      "verified_date": "2025-11-15"
    },
    {
      "id": "moncler_plp_005",
      "site": "MONCLER_OFFICIAL",
      "error_signature": "Homepage detected instead of PLP",
      "conditions": {
        "url_pattern": "^https?://www\\.moncler\\.com/en-[a-z]{2}/?$"
      },
      "root_cause": "PLP ナビ後にホームページへリダイレクトされている",
      "solution_pattern": [
