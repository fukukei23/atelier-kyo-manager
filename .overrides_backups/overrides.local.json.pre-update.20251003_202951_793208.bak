{
  "SSENSE": {
    "home_url": "https://www.ssense.com/en-gb",
    "discovery_settings": {
      "use_warm_up": true,
      "use_http2_fallback": false,
      "max_navigation_attempts": 2,
      "navigation_tactics": [
        "direct_brand_url"
      ],
      "url_templates": {
        "direct_brand_url": "/en-gb/men/designers/{brand}"
      },
      "timeout_sec": 20
    },
    "selectors": {
      "pdp": {
        "pdp_link_selectors": [
          "a:has(img[alt*='{brand}'])",
          "article a:has(img)",
          "a[href*='/men/'][href*='/product']",
          "a[href*='/women/'][href*='/product']"
        ]
      }
    }
  },
  "MATCHESFASHION": {
    "home_url": "https://www.matchesfashion.com/intl",
    "discovery_settings": {
      "use_warm_up": false,
      "use_http2_fallback": true,
      "max_navigation_attempts": 3,
      "navigation_tactics": [
        "designers_hub",
        "direct_brand_url"
      ],
      "url_templates": {
        "designers_hub": "/intl/designers",
        "direct_brand_url": "/intl/designers/{brand}"
      },
      "timeout_sec": 45
    },
    "selectors": {
      "pdp": {
        "pdp_link_selectors": [
          "a[data-testid='product-card-link']:has(img[alt])",
          ".lister__product a[href*='/products/']"
        ]
      }
    }
  },
  "GIVENCHY_OFFICIAL": {
    "home_url": "https://www.givenchy.com",
    "discovery_settings": {
      "navigation_tactics": [
        "official_catalog"
      ],
      "url_templates": {
        "official_catalog": "/en-en/men/new-in"
      },
      "fallback_url": "/en-en/men/new-in",
      "timeout_sec": 30,
      "max_navigation_attempts": 2
    },
    "selectors": {
      "pdp": {
        "plp_container_selectors": [
          ".product-grid",
          ".plp",
          "main .grid"
        ],
        "pdp_link_selectors": [
          ".product-grid a[href*='/en-en/'][href*='/p/']",
          ".product-grid a:has(img)"
        ]
      }
    }
  },
  "MONCLER_OFFICIAL": {
    "home_url": "https://www.moncler.com/en-int",
    "allowed_domain": "moncler.com",
    "discovery_settings": {
      "navigation_tactics": [
        "official_catalog",
        "search",
        "fallback_url"
      ],
      "url_templates": {
        "official_catalog": "https://www.moncler.com/en-int/women/outerwear/down-jackets",
        "search": "/search?q={query}",
        "fallback_url": "https://www.moncler.com/en-int/women"
      },
      "timeout_sec": 45,
      "search_keyword": "down jacket",
      "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
      "extra_http_headers": {
        "Accept-Language": "en-IT,en;q=0.9",
        "Referer": "https://www.moncler.com/",
        "DNT": "1"
      }
    },
    "selectors": {
      "pdp": {
        "plp_container_selectors": [
          "[data-qa='plp-grid']",
          "[data-qa='search-grid']",
          "main .product-grid",
          "section[class*='product']",
          "[data-testid='product-list']",
          "ul[class*='grid']"
        ],
        "pdp_link_selectors": [
          ".product-card__title",
          "a[data-e2e='product-link']",
          "a[data-qa='product-tile-link']",
          "[data-qa='product-tile'] a[href*='/products/']",
          "a[data-qa='product-card-link']",
          "a[href*='/en-int/'][href*='/products/']",
          "a[href*='/en/'][href*='/products/']",
          "a[href*='/en-int/'][href*='/p/']",
          "a[href*='/products/']"
        ]
      }
    }
  },
  "SAINT_LAURENT_OFFICIAL": {
    "home_url": "https://www.ysl.com/en-en",
    "allowed_domain": "ysl.com",
    "discovery_settings": {
      "navigation_tactics": [
        "official_catalog"
      ],
      "url_templates": {
        "official_catalog": "https://www.ysl.com/en-en/shop-women/handbags"
      },
      "extra_http_headers": {
        "Accept-Language": "en-GB,en;q=0.9"
      }
    },
    "selectors": {
      "pdp": {
        "plp_container_selectors": [
          ".product-grid",
          "[data-testid='product-list']"
        ],
        "pdp_link_selectors": [
          "a[href*='/product/']",
          "a[href*='/p/']"
        ]
      }
    }
  },
  "MARGIELA_OFFICIAL": {
    "home_url": "https://www.maisonmargiela.com/en",
    "discovery_settings": {
      "navigation_tactics": [
        "official_catalog"
      ],
      "url_templates": {
        "official_catalog": "/en/women/shoes"
      },
      "fallback_url": "/en/women/shoes",
      "timeout_sec": 30
    },
    "selectors": {
      "pdp": {
        "plp_container_selectors": [
          "main .product-grid",
          "[data-testid='product-list']"
        ],
        "pdp_link_selectors": [
          "a[href*='/en/'][href*='/products/']",
          "a:has(img)"
        ]
      }
    }
  },
  "GOLDEN_GOOSE_OFFICIAL": {
    "home_url": "https://www.goldengoose.com/en",
    "discovery_settings": {
      "navigation_tactics": [
        "official_catalog"
      ],
      "url_templates": {
        "official_catalog": "/en/women/sneakers"
      },
      "fallback_url": "/en/women/sneakers",
      "timeout_sec": 40,
      "search_keyword": "sneakers"
    },
    "selectors": {
      "pdp": {
        "plp_container_selectors": [
          "main .product-grid",
          "[data-testid='product-list']"
        ],
        "pdp_link_selectors": [
          "a[href*='/en/'][href*='/product/']",
          "a:has(img)"
        ]
      }
    }
  }
}